# Supabase (local: run `npx supabase start` and copy values from its output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini — model is never hardcoded; change tier/model here only
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Telegram (create the bot with @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
# Any random string you choose (A-Z a-z 0-9 _ -); Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public site URL (used for webhook registration and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Minutes before an unconfirmed meal log is auto-confirmed
AUTO_CONFIRM_MINUTES=10

# Secret for the hourly nudge cron (Authorization: Bearer <value>). Generate: openssl rand -hex 32
CRON_SECRET=PASTE_A_LONG_RANDOM_STRING
